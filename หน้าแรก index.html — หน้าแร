<style>

/* =========================
   RESET
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
}

:root {
    --green-dark: #176b3a;
    --green: #2e8b57;
    --green-light: #a8d5ba;
    --green-soft: #e8f5e9;

    --white: #ffffff;
    --cream: #f7fcf8;

    --gold: #d6a84f;
    --gold-light: #f4e7c1;

    --text-dark: #26382d;
    --text: #53645a;
    --border: #dce9df;
}

body {
    font-family: Arial, "Tahoma", sans-serif;

    background:
        linear-gradient(
            135deg,
            #f7fcf8 0%,
            #edf8f0 45%,
            #ffffff 100%
        );

    color: var(--text-dark);

    line-height: 1.8;
}

img {
    max-width: 100%;
    display: block;
}


/* =========================
   NAVBAR
========================= */

nav {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(255,255,255,0.95);

    backdrop-filter: blur(10px);

    border-bottom: 1px solid var(--border);

    box-shadow:
        0 3px 20px rgba(23,107,58,0.08);

    padding: 15px 20px;

    display: flex;
    justify-content: center;
    align-items: center;

    gap: 28px;
}

nav a {
    color: var(--green-dark);

    text-decoration: none;

    font-size: 15px;

    font-weight: 600;

    transition: 0.3s;
}

nav a:hover {
    color: var(--gold);
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 680px;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 80px 20px;

    position: relative;

    background:
        radial-gradient(
            circle at top right,
            #c9ebd4 0%,
            transparent 35%
        ),
        radial-gradient(
            circle at bottom left,
            #e7f5e9 0%,
            transparent 40%
        );
}

.hero-symbol {
    font-size: 40px;

    letter-spacing: 10px;

    margin-bottom: 25px;

    color: var(--green);
}

.hero-image {
    width: 190px;
    height: 240px;

    object-fit: cover;

    border-radius: 18px;

    margin-bottom: 30px;

    border: 6px solid var(--green-soft);

    box-shadow:
        0 15px 40px rgba(23,107,58,0.15);
}

.hero-small {
    color: var(--green);

    font-size: 15px;

    margin-bottom: 10px;

    letter-spacing: 4px;

    font-weight: bold;
}

.hero h1 {
    font-size: clamp(42px, 8vw, 75px);

    line-height: 1;

    letter-spacing: 3px;

    color: var(--green-dark);

    margin-bottom: 20px;
}

.hero h2 {
    font-size: clamp(22px, 4vw, 34px);

    font-weight: 500;

    color: var(--text);

    margin-bottom: 15px;
}

.hero p {
    color: #65746b;

    margin: 4px 0;
}

.hero-interest {
    color: var(--green-dark) !important;

    font-weight: bold;
}

.hero-button {
    display: inline-block;

    margin-top: 35px;

    padding: 12px 30px;

    border: 1px solid var(--green-light);

    border-radius: 30px;

    color: var(--green-dark);

    text-decoration: none;

    background: white;

    font-weight: bold;

    transition: 0.3s;
}

.hero-button:hover {
    background: var(--green);

    color: white;

    transform: translateY(-3px);
}


/* =========================
   MAIN
========================= */

.container {
    width: min(1000px, 92%);

    margin: auto;
}


/* =========================
   SECTION
========================= */

section {
    padding: 85px 0;
}

.section-title {
    text-align: center;

    margin-bottom: 50px;
}

.section-title span {
    display: block;

    color: var(--green);

    font-size: 14px;

    letter-spacing: 4px;

    margin-bottom: 8px;

    font-weight: bold;
}

.section-title h2 {
    font-size: 34px;

    color: var(--green-dark);
}


/* =========================
   CARD
========================= */

.card {
    background: var(--white);

    border: 1px solid var(--border);

    border-radius: 18px;

    padding: 40px;

    box-shadow:
        0 10px 35px rgba(23,107,58,0.07);

    margin-bottom: 30px;
}


/* =========================
   PREFACE
========================= */

.preface {
    max-width: 850px;

    margin: auto;
}

.preface p {
    margin-bottom: 20px;

    color: var(--text);

    text-align: left;
}

.signature {
    text-align: right !important;

    color: var(--green-dark) !important;

    font-weight: bold;
}


/* =========================
   ABOUT
========================= */

.about-grid {
    display: grid;

    grid-template-columns: 300px 1fr;

    gap: 50px;

    align-items: center;
}

.profile-image {
    width: 100%;

    height: 390px;

    object-fit: cover;

    border-radius: 18px;

    border: 6px solid var(--green-soft);

    box-shadow:
        0 15px 35px rgba(23,107,58,0.15);
}

.profile-info h3 {
    font-size: 28px;

    color: var(--green-dark);

    margin-bottom: 25px;
}

.info-row {
    display: flex;

    gap: 15px;

    padding: 13px 0;

    border-bottom: 1px solid var(--border);
}

.info-row strong {
    min-width: 150px;

    color: var(--green);
}

.info-row span {
    color: var(--text);
}


/* =========================
   CONTACT
========================= */

.contact-box {
    margin-top: 35px;

    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 15px;
}

.contact-box a {
    text-decoration: none;

    color: var(--text-dark);

    background: var(--green-soft);

    border: 1px solid var(--border);

    padding: 16px;

    border-radius: 12px;

    transition: 0.3s;
}

.contact-box a:hover {
    transform: translateY(-4px);

    border-color: var(--green);

    background: var(--green-light);

    color: var(--green-dark);
}


/* =========================
   UNIVERSITY
========================= */

.university-card {
    text-align: center;

    max-width: 850px;

    margin: auto;
}

.university-image {
    width: 300px;

    margin: 0 auto 30px;

    border-radius: 15px;

    border: 6px solid var(--green-soft);

    box-shadow:
        0 10px 25px rgba(23,107,58,0.1);
}

.university-card h3 {
    font-size: 28px;

    color: var(--green-dark);

    margin-bottom: 8px;
}

.university-card h4 {
    font-size: 20px;

    color: var(--green);

    margin-bottom: 20px;
}

.university-card p {
    color: var(--text);

    text-align: left;

    margin-bottom: 15px;
}

.goal {
    margin-top: 30px;

    background: var(--green-soft);

    border-left: 5px solid var(--green);

    padding: 20px 25px;

    border-radius: 8px;

    text-align: left;
}

.goal strong {
    color: var(--green-dark);

    font-size: 18px;
}


/* =========================
   WORKS
========================= */

.work-card {
    background: white;

    border: 1px solid var(--border);

    border-radius: 18px;

    overflow: hidden;

    margin-bottom: 35px;

    box-shadow:
        0 10px 35px rgba(23,107,58,0.07);
}

.work-content {
    padding: 35px;
}

.work-content h3 {
    font-size: 25px;

    color: var(--green-dark);

    margin-bottom: 15px;
}

.work-content p {
    color: var(--text);

    margin-bottom: 20px;
}

.award {
    display: inline-block;

    padding: 7px 18px;

    border-radius: 30px;

    background:
        linear-gradient(
            135deg,
            #f5e8bf,
            #fff8df
        );

    color: #8a6a20;

    border: 1px solid #ead79c;

    font-size: 14px;

    font-weight: bold;

    margin-bottom: 25px;
}

.work-images {
    display: grid;

    grid-template-columns: repeat(2,1fr);

    gap: 12px;
}

.work-images img {
    width: 100%;

    height: 300px;

    object-fit: cover;

    border-radius: 12px;

    border: 3px solid white;

    box-shadow:
        0 5px 18px rgba(23,107,58,0.12);

    transition: 0.3s;
}

.work-images img:hover {
    transform: scale(1.015);

    box-shadow:
        0 8px 25px rgba(23,107,58,0.2);
}

.skill-title {
    color: var(--green) !important;

    font-weight: bold;

    margin-top: 25px;

    margin-bottom: 5px;
}


/* =========================
   DECORATION
========================= */

.decor {
    text-align: center;

    font-size: 30px;

    letter-spacing: 12px;

    padding: 50px 0;

    color: var(--green);
}


/* =========================
   THANK YOU
========================= */

.thanks {
    text-align: center;

    padding: 90px 20px;
}

.thanks h2 {
    font-size: 38px;

    color: var(--green-dark);

    margin-bottom: 20px;
}

.thanks p {
    color: var(--text);

    margin-bottom: 8px;
}

.thanks .big {
    font-size: 35px;

    margin: 30px 0;
}


/* =========================
   BACK
========================= */

.back {
    text-align: center;

    padding: 25px 0 70px;
}

.back a {
    display: inline-block;

    padding: 10px 28px;

    border: 1px solid var(--green-light);

    border-radius: 30px;

    text-decoration: none;

    color: var(--green-dark);

    background: white;

    font-weight: bold;

    transition: 0.3s;
}

.back a:hover {
    background: var(--green);

    color: white;
}


/* =========================
   FOOTER
========================= */

footer {
    border-top: 4px solid var(--gold);

    text-align: center;

    padding: 30px 20px;

    color: #eaf5ed;

    background:
        linear-gradient(
            135deg,
            #176b3a,
            #2e8b57
        );
}

footer strong {
    color: white;

    font-size: 18px;
}


/* =========================
   MOBILE
========================= */

@media (max-width:768px) {

    nav {
        gap: 13px;

        padding: 12px 8px;

        overflow-x: auto;

        justify-content: flex-start;

        white-space: nowrap;
    }

    nav a {
        font-size: 13px;
    }

    .hero {
        min-height: 620px;
    }

    .hero-image {
        width: 160px;

        height: 210px;
    }

    .hero h1 {
        font-size: 42px;
    }

    section {
        padding: 60px 0;
    }

    .card {
        padding: 25px;
    }

    .about-grid {
        grid-template-columns: 1fr;

        gap: 30px;
    }

    .profile-image {
        width: 230px;

        height: 300px;

        margin: auto;
    }

    .contact-box {
        grid-template-columns: 1fr;
    }

    .work-images {
        grid-template-columns: 1fr;
    }

    .work-images img {
        height: 250px;
    }

    .info-row {
        flex-direction: column;

        gap: 2px;
    }

    .section-title h2 {
        font-size: 28px;
    }

}

</style>

</head>


